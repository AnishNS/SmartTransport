# Supabase project settings for the web app (Vite).
# Copy this file to .env and fill in your project values.
#
# VITE_SUPABASE_URL  -> Supabase Dashboard > Project Settings > API > Project URL
# VITE_SUPABASE_ANON_KEY -> Supabase Dashboard > Project Settings > API > `anon` public key
#
# Only the anon/public key belongs in the frontend. NEVER use the service_role
# key or any database password here.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Optional override for the Node/Express backend URL. Leave unset for local
# development: the frontend talks to the backend through the same origin and the
# Vite dev server proxies /api and /socket.io (websocket included) to the
# backend, so it works from any LAN device. Set this to an absolute URL only
# when the API is served elsewhere (e.g. a tunnel or separate host).
# VITE_API_URL=
