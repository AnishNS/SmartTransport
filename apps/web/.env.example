# Supabase project settings for the web app (Vite).
# Copy this file to .env and fill in your project values.
#
# VITE_SUPABASE_URL  -> Supabase Dashboard > Project Settings > API > Project URL
# VITE_SUPABASE_ANON_KEY -> Supabase Dashboard > Project Settings > API > `anon` public key
#
# Only the anon/public key belongs in the frontend. NEVER use the service_role
# key or any database password here.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Node/Express backend URL used by admin features (driver management).
# Defaults to http://localhost:5000 when omitted.
VITE_API_URL=http://localhost:5000
