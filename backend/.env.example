# Backend environment template. Copy this file to .env and fill in the values.

# HTTP port for the Express server.
PORT=5000

# Supabase project URL (Supabase Dashboard > Settings > API > Project URL).
SUPABASE_URL=

# ANON (public) key — used for normal client-style queries that respect RLS.
SUPABASE_KEY=

# SERVICE_ROLE key — SERVER ONLY. Required for the GoTrue Admin API (creating
# driver auth accounts) and for managing driver profiles/roles from the
# backend. NEVER expose this in the frontend or in any VITE_* variable.
# Supabase Dashboard > Settings > API > `service_role` secret.
SUPABASE_SERVICE_ROLE_KEY=

# Credentials used by `npm run seed:admin` to create the real admin Auth account.
SUPABASE_ADMIN_EMAIL=admin@smarttransport.com
SUPABASE_ADMIN_PASSWORD=Admin@123
SUPABASE_ADMIN_NAME=Vijay Raghavan
SUPABASE_ADMIN_PHONE=+91 98765 00001
